{% macro photo(method, sample) -%}
<div class="photo-frame{% if method.is_original %} is-original{% endif %}">
    <img src="{{ image_src(method, sample) }}" alt="{{ sample.display_name }} — {{ method.name }}" loading="lazy">
</div>
{%- endmacro %}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Porównanie zdjęć produktowych</title>
    <style>
{{ styles | safe }}
    </style>
</head>
<body class="crop-3-5 tone-{{ default_photo_tone }}">
<header class="controls">
    <fieldset>
        <legend>Widok</legend>
        <button type="button" data-view="comparison" aria-pressed="true">Porównanie produktu</button>
        <button type="button" data-view="storefront" aria-pressed="false">Storefront</button>
    </fieldset>
    <fieldset>
        <legend>Tło</legend>
        {% for tone in photo_tones %}
        <button type="button" data-tone="{{ tone.id }}" aria-pressed="{{ 'true' if tone.id == default_photo_tone else 'false' }}">{{ tone.label }}</button>
        {% endfor %}
    </fieldset>
    <fieldset>
        <legend>Kadr</legend>
        <button type="button" data-crop="3-5" aria-pressed="true">3:5</button>
        <button type="button" data-crop="9-16" aria-pressed="false">9:16</button>
        <button type="button" data-crop="3-4" aria-pressed="false">3:4</button>
        <button type="button" data-crop="1-1" aria-pressed="false">1:1</button>
    </fieldset>
    <fieldset>
        <legend>Liczba kolumn</legend>
        <button type="button" data-columns="auto" aria-pressed="true">Auto</button>
        {% for count in [2, 3, 4, 6, 8] %}
        <button type="button" data-columns="{{ count }}" aria-pressed="false">{{ count }}</button>
        {% endfor %}
    </fieldset>
</header>

<main>
    <table>
        <caption>Czas przetwarzania na Apple M1 Pro</caption>
        <thead>
            <tr>
                <th scope="col">Metoda</th>
                <th scope="col">Czas na zdjęcie</th>
                <th scope="col">Szacunek dla 10 000 zdjęć</th>
            </tr>
        </thead>
        <tbody>
            {% for method in methods %}
            <tr>
                <th scope="row">{{ method.name }}</th>
                <td>{{ method.time_per_image }}</td>
                <td>{{ method.time_per_10k }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <section id="view-comparison" aria-label="Porównanie produktu">
        {% for sample in samples %}
        <article>
            <h2>{{ sample.display_name }}</h2>
            <div class="image-grid">
                {% for method in methods %}
                <figure>
                    <figcaption>{{ method.name }}</figcaption>
                    {{ photo(method, sample) }}
                </figure>
                {% endfor %}
            </div>
        </article>
        {% endfor %}
    </section>

    <section id="view-storefront" aria-label="Storefront" hidden>
        {% for method in methods %}
        <article>
            <h2>{{ method.name }}</h2>
            <div class="image-grid">
                {% for sample in samples %}
                <figure>
                    {{ photo(method, sample) }}
                    <figcaption>{{ sample.display_name }}</figcaption>
                </figure>
                {% endfor %}
            </div>
        </article>
        {% endfor %}
    </section>
</main>

<script>
{{ script | safe }}
</script>
</body>
</html>
