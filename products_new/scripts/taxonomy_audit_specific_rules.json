        "keywords": "turtleneck, mock neck, roll neck, funnel neck, high neck, stand/band/mandarin collar",
        "source": "text"
      },
      "Collared": {
        "patterns": [
          "\\bcollared\\b",
          "\\b(?:point(?:ed)?|spread|cutaway|polo|shirt|classic|camp|cuban|revere|convertible|fold[\\s-]*over|turn[\\s-]*down|notched|shawl)[\\s-]+collar\\b",
