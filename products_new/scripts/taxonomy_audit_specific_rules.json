        "source": "text",
        "note": "Nie liczymy samego collar, ponieważ rib-knit crewneck collar nie oznacza wykładanego kołnierza."
      },
      "Square Neck": {
        "patterns": [
          "\\bsquare[\\s-]+(?:neck|neckline)\\b"
        ],
        "keywords": "square neck, square neckline",
