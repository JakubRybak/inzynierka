      },
      "V-Neck": {
        "patterns": [
          "\\bv[\\s-]*(?:neck|neckline)\\b",
          "\\bplung(?:e|ing)\\b",
          "\\bsurplice\\b",
          "\\by[\\s-]*(?:neck|neckline)\\b"
