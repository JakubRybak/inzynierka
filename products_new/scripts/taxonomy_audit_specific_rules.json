          "\\b(?:neck|neckline)[\\s-]+(?:is[\\s-]+)?asymmetr(?:ic|ical)\\b"
        ],
        "keywords": "asymmetric/asymmetrical neckline",
        "source": "text",
        "note": "Samo asymmetric, one-shoulder lub asymetryczny dół nie przesądzają o dekolcie."
      },
      "Other": {
        "patterns": [
          "\\bcollared\\b",
          "\\b(?:point(?:ed)?|spread|cutaway|polo|shirt|classic|camp|cuban|revere|convertible|fold[\\s-]*over|turn[\\s-]*down|notched|shawl)[\\s-]+collar\\b",
          "\\bbutton[\\s-]+down[\\s-]+collar\\b",
          "\\blapels?\\b",
          "\\bsquare[\\s-]+(?:neck|neckline)\\b",
          "\\bboat[\\s-]*(?:neck|neckline)\\b",
          "\\bbateau\\b",
          "\\bslash[\\s-]+(?:neck|neckline)\\b",
          "\\bsweet[\\s-]*heart\\b",
          "\\bcowl(?:[\\s-]+(?:neck|neckline))?\\b",
          "\\bstraight[\\s-]+(?:across[\\s-]+)?(?:neck|neckline)\\b",
          "\\bstraight[\\s-]+(?:top|upper)[\\s-]+edge\\b",
          "\\basymmetr(?:ic|ical)[\\s-]+(?:neck|neckline)\\b",
          "\\b(?:neck|neckline)[\\s-]+(?:is[\\s-]+)?asymmetr(?:ic|ical)\\b"
