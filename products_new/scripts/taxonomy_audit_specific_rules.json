{
  "features": {
    "sleeve_length": {
      "Sleeveless": {
        "patterns": [
          "\\bsleeveless\\b",
          "\\b(?:no|without)[\\s-]+sleeves\\b",
          "\\bstrapless\\b",
          "\\bbandeau\\b",
          "\\btube[\\s-]+(?:top|dress|bodysuit)\\b"
        ],
        "keywords": "sleeveless, no/without sleeves, strapless, bandeau, tube top/dress",
        "source": "text",
        "note": "Strapless/bandeau/tube są szerokimi wskaźnikami braku rękawów; nie wyciągamy wniosku z samej kategorii."
      },
      "Short Sleeve": {
        "patterns": [
          "\\b(?:short|cap)[\\s-]*sleeve(?:d|s)?\\b"
        ],
        "keywords": "short sleeve, short-sleeved, cap sleeve",
        "source": "text"
      },
      "Three-Quarter Sleeve": {
        "patterns": [
          "\\b(?:three[\\s-]+quarter(?:s)?|3\\s*/\\s*4|three[\\s-]+fourth(?:s)?)[\\s-]+(?:length[\\s-]+)?sleeve(?:d|s)?\\b"
        ],
        "keywords": "three-quarter sleeve, 3/4 sleeve, three-fourths sleeve",
        "source": "text"
      },
      "Long Sleeve": {
        "patterns": [
          "\\b(?:long|full[\\s-]+length|extra[\\s-]+long)[\\s-]*sleeve(?:d|s)?\\b"
        ],
        "keywords": "long sleeve, long-sleeved, full-length sleeve, extra-long sleeve",
        "source": "text"
      }
    },
    "neckline": {
