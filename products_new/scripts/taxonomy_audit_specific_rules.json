        "keywords": "crewneck, crew neck, round/rounded neck, jewel neck",
        "source": "text",
        "note": "Round neck to szeroki wskaźnik: może obejmować także Scoop Neck."
      },
      "Scoop Neck": {
        "patterns": [
          "\\bscoop(?:ed)?[\\s-]*(?:neck|neckline)\\b",
          "\\bu[\\s-]*(?:neck|neckline)\\b",
          "\\bdeep[\\s-]+round[\\s-]+(?:neck|neckline)\\b"
